{
  "name": "@kairo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backfill": "tsx --env-file-if-exists=../../.env src/cli/backfill.ts",
    "backfill:prod": "node dist/cli/backfill.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@kairo/core": "workspace:*",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
