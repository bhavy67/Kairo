# demo: fake portfolio, no broker. kite: real Zerodha account.
DATA_MODE=demo

# --- Required when DATA_MODE=kite ---
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# From https://developers.kite.trade (Personal app is free).
# Set the app's redirect URL to: <your site>/api/auth/callback
KITE_API_KEY=
KITE_API_SECRET=
# Your Kite client ID. Any other account is rejected at login.
KITE_ALLOWED_USER_ID=

# Postgres. Leave unset in development to use an embedded database in apps/api/.data.
# DATABASE_URL=postgres://kairo:kairo@localhost:5432/kairo

# Import NSE end-of-day files every evening (after 18:30 IST).
INGEST_SCHEDULE=true

# API listener (the web app proxies /api to it)
PORT=4000
HOST=127.0.0.1
